{
  "$comment": "Public scanner discovery card",
  "name": "BackBond Agent Scan",
  "description": "Run deterministic local security rules over agent tools, permissions, and traces.",
  "url": "https://backbond.ai/agent-scan/",
  "provider": {
    "organization": "BackBond",
    "url": "https://backbond.ai"
  },
  "version": "0.5.15",
  "documentationUrl": "https://github.com/BackBond/agent-scan",
  "rulesUrl": "https://backbond.ai/agent-scan/rules/",
  "commands": {
    "vetBeforeAttach": "npx -y @backbond/agent-scan@0.5.15 vet-tools --stdin < tools-list.json",
    "scanSuppliedTools": "npx -y @backbond/agent-scan@0.5.15 scan --stdin --require-coverage < tools-list.json",
    "installAgentSkill": "npx -y skills@1.5.18 add https://github.com/BackBond/agent-scan/tree/v0.5.15 --skill agent-scan --yes"
  },
  "capabilities": {
    "streaming": false,
    "pushNotifications": false
  },
  "defaultInputModes": ["application/json"],
  "defaultOutputModes": ["application/json"],
  "skills": [
    {
      "id": "scan_agent_evidence",
      "name": "Scan my runtime evidence",
      "description": "Run the open local rule pack and create a tamper-evident receipt or redacted self-run public record.",
      "tags": ["agent-security", "static-analysis", "receipt", "scan-record"]
    },
    {
      "id": "vet_tools_before_attach",
      "name": "Vet tools before attaching them",
      "description": "Return a scoped static block, review, or no-blocking-finding decision for a supplied tool manifest.",
      "tags": ["agent-security", "pre-attachment", "mcp", "static-analysis"]
    }
  ]
}
